@import "../../app.wxss";
.event { width: 100%; box-sizing: border-box; text-align: left; background: transparent; color: var(--text); border-radius: 0; border-top: 1rpx solid var(--soft); margin: 16rpx 0 0; padding: 16rpx 0 0; line-height: 1.55; font-size: 28rpx; overflow-wrap: anywhere; min-height: 65rpx; }
.event::after { border: none; }
