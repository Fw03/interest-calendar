.calendar-hero { margin-bottom: 4rpx; }
.calendar { padding: 22rpx 16rpx 17rpx; }
.month-nav { padding: 0 10rpx; margin-bottom: 18rpx; }
.month-title { color: var(--brand); font: 700 52rpx Georgia, serif; white-space: nowrap; }
.month-label { font: 650 26rpx sans-serif; margin-left: 6rpx; }
.month-year { margin-left: 13rpx; }
.month-actions { gap: 8rpx; flex-shrink: 0; }
.button.month-arrow { width: 74rpx; flex: 0 0 74rpx; padding: 0; font-size: 43rpx; }
.button.month-today { width: 116rpx; flex: 0 0 116rpx; padding: 0; }
.grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); text-align: center; }
.weekdays { margin-bottom: 8rpx; }
.grid-days { row-gap: 5rpx; }
.day { display: flex; flex-direction: column; align-items: center; justify-content: center; width: 100%; min-height: 77rpx; min-width: 0; box-sizing: border-box; text-align: center; padding: 0; background: transparent; color: var(--text); border-radius: 14rpx; line-height: 1.15; }
.day-number { font-family: Georgia, serif; font-size: 31rpx; }
.lunar { font-size: 18rpx; margin-top: 3rpx; color: var(--muted); white-space: nowrap; }
.day.other-month { color: var(--muted); }
.day.today { background: var(--soft); font-weight: bold; }
.day.selected { background: var(--brand); color: var(--onBrand); }
.day.selected .lunar { color: var(--onBrand); }
.selected-heading { padding: 12rpx 0 0; }
