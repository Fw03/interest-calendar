page { font-family: -apple-system, "PingFang SC", sans-serif; font-size: 28rpx; }
.screen { min-height: 100vh; box-sizing: border-box; background: var(--bg); color: var(--text); padding: 30rpx 32rpx 58rpx; padding-bottom: calc(58rpx + env(safe-area-inset-bottom)); }
.stack { display: flex; flex-direction: column; gap: 18rpx; }
.panel { background: var(--card); border-radius: 26rpx; padding: 26rpx; }
.row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.wrap { flex-wrap: wrap; }
.grow { flex: 1; min-width: 0; }
.hero { margin: 8rpx 0 26rpx; }
.hero-title { display: block; font-family: Georgia, "Songti SC", serif; font-weight: 700; font-size: 50rpx; letter-spacing: 1rpx; }
.section-title { display: block; font-size: 33rpx; font-weight: 700; }
.card-title { display: block; font-weight: 650; color: var(--text); }
.muted { color: var(--muted); font-size: 25rpx; line-height: 1.55; }
.body-text { line-height: 1.65; margin-top: 16rpx; overflow-wrap: anywhere; white-space: pre-wrap; }
.button { display: inline-flex; justify-content: center; align-items: center; box-sizing: border-box; width: auto; min-width: 0; min-height: 76rpx; margin: 0; padding: 0 23rpx; border: 0; border-radius: 40rpx; background: var(--soft); color: var(--brand); font-size: 26rpx; line-height: 1.25; }
.button::after { border: none; }
.button[disabled] { background: var(--soft); color: var(--muted); opacity: .65; }
.primary { background: var(--brand); color: var(--onBrand); }
.mark { background: var(--soft); color: var(--brand); width: 64rpx; height: 64rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 18rpx; font-size: 31rpx; }
.divider { border-top: 1rpx solid var(--soft); margin-top: 16rpx; padding-top: 16rpx; }
.wide { width: 100%; }
